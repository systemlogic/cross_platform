# Register toolchains
build --incompatible_enable_cc_toolchain_resolution

# Linux arm64 target.
# On x86_64 exec: selects gcc_arm64_toolchain (ARM cross-compiler).
# On aarch64 exec: selects gcc_arm64_native_toolchain (LLVM aarch64 + Bootlin aarch64 sysroot).
build:arm64 --platforms=//:arm64_platform
build:arm64 --cpu=arm64
build:arm64 --extra_toolchains=//:gcc_arm64_toolchain,//:gcc_arm64_native_toolchain

# Linux x86_64 target.
# On x86_64 exec: selects gcc_x86_64_toolchain (Bootlin native x86_64 GCC).
# On aarch64 exec: selects clang_x86_64_on_linux_aarch64_toolchain (LLVM + Bootlin sysroot).
build:x86_64 --platforms=//:x86_64_platform
build:x86_64 --extra_toolchains=//:gcc_x86_64_toolchain,//:clang_x86_64_on_linux_aarch64_toolchain

# macOS platforms — downloaded LLVM, no host compiler used.
# Toolchain is auto-selected via register_toolchains in MODULE.bazel based on exec constraints:
#   macOS arm64 exec  → LLVM 18.1.8 arm64-apple-macos11
#   macOS x86_64 exec → LLVM 17.0.6 x86_64-apple-darwin22.0
build:macos_arm64  --platforms=//:macos_arm64_platform
build:macos_x86_64 --platforms=//:macos_x86_64_platform

# Build modes — combinable with any --config=<platform> flag
# e.g. bazel build --config=arm64 --config=release //examples/cc:hello

# Debug: no optimization, full debug symbols, DEBUG_BUILD defined
build:debug --compilation_mode=dbg
build:debug --copt=-DDEBUG_BUILD

# Release: -O2 + -DNDEBUG (via Bazel opt mode), strip debug symbols
build:release --compilation_mode=opt
build:release --linkopt=-Wl,--strip-all

# Stats: gprof-compatible profiling instrumentation + STATS_ENABLED define
build:stats --compilation_mode=dbg
build:stats --copt=-pg
build:stats --copt=-DSTATS_ENABLED
build:stats --linkopt=-pg
