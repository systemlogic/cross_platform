load("//python:defs.bzl", "py_self_executable")
load("//license:report.bzl", "license_report")

# Build with:
#   ./bazel build //examples/python:demo
#
# Run with:
#   ./bazel-bin/examples/python/demo
#
# On first execution the bundle is extracted to ~/.cache/py_exe/<hash>/.
# Subsequent runs start instantly from the cached extraction.
#
# To add pip packages:
#   1. Add python_ext.pip() entries in MODULE.bazel.
#   2. Add use_repo() for each new name.
#   3. Add "@pip_<name>//:pkg" to the deps list below.

py_self_executable(
    name = "demo",
    main = "main.py",
    srcs = ["main.py"],
    deps = [
        "@pip_requests//:pkg",
        "@pip_urllib3//:pkg",
        "@pip_certifi//:pkg",
        "@pip_charset_normalizer//:pkg",
        "@pip_idna//:pkg",
    ],
)

# License report for the Python demo and all its transitive dependencies.
# Build:  ./bazel build //examples/python:demo_licenses
# Read:   cat bazel-bin/examples/python/demo_licenses_license_report.txt
license_report(
    name = "demo_licenses",
    target = ":demo",
    artifact_name = "Python requests demo (//examples/python:demo)",
    deps_licenses = [
        "//license:project_license",
        "//license:python_requests",
    ],
)
