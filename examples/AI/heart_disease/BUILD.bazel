load("//python:defs.bzl", "py_runnable")

# Build with:
#   ./bazel build --config=macos_arm64 //examples/AI/heart_disease:heart_disease
#
# Run with (bundled CSV, MPS device):
#   ./bazel run --config=macos_arm64 //examples/AI/heart_disease:heart_disease -- --device mps
#
# Run with a custom CSV or device:
#   ./bazel run --config=macos_arm64 //examples/AI/heart_disease:heart_disease -- --device cpu --data /path/to/data.csv

py_runnable(
    name = "heart_disease",
    main = "main.py",
    srcs = ["main.py"],
    data = ["disease_prediction.csv"],
    deps = [
        # Primary packages
        "@pip_torch//:pkg",
        "@pip_torchvision//:pkg",
        # torch pure-Python dependencies
        "@pip_filelock//:pkg",
        "@pip_fsspec//:pkg",
        "@pip_jinja2//:pkg",
        "@pip_markupsafe//:pkg",
        "@pip_networkx//:pkg",
        "@pip_setuptools//:pkg",
        "@pip_mpmath//:pkg",
        "@pip_sympy//:pkg",
        "@pip_typing_extensions//:pkg",
        # torchvision dependencies
        "@pip_numpy//:pkg",
        "@pip_pillow//:pkg",
    ],
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)
