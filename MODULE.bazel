# Expose the Apple CC toolchains repo so .bazelrc can reference it via
# @local_config_apple_cc_toolchains. We add it to --extra_toolchains
# globally so it takes priority over our LLVM toolchain for Apple
# platform targets (which carry the :apple constraint). Plain C/C++
# targets don't have :apple, so the LLVM toolchain still wins for those.
apple_cc_configure = use_extension(
    "@apple_support//crosstool:setup.bzl",
    "apple_cc_configure_extension",
)
use_repo(apple_cc_configure, "local_config_apple_cc_toolchains")

# Go
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.36.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.module(
    path = "google.golang.org/grpc",
    sum = "h1:kF77BGdPTQ4/JZWMlb9VpJ5pa25aqvVqogsxNHHdeBg=",
    version = "v1.71.0",
)
go_deps.module(
