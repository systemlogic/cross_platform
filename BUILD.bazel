load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# Mandatory empty filegroup for unused toolchain attributes
filegroup(name = "empty")

# --- x86_64 Toolchain ---
cc_toolchain_config(
    name = "x86_64_config",
    cpu = "x86_64",
    gcc_path = "external/gcc_9_x86_64/bin/x86_64-linux-gcc", 
    ld_path = "external/gcc_9_x86_64/bin/x86_64-linux-ld",
    ar_path = "external/gcc_9_x86_64/bin/x86_64-linux-ar",
    cpp_path = "external/gcc_9_x86_64/bin/x86_64-linux-cpp",
    sysroot_path = "external/gcc_9_x86_64",
)

cc_toolchain(
    name = "cc_x86_64",
    all_files = "@gcc_9_x86_64//:all_files",
    compiler_files = "@gcc_9_x86_64//:all_files",
    dwp_files = ":empty",        # Added
    linker_files = "@gcc_9_x86_64//:all_files",
    objcopy_files = ":empty",    # Added
    strip_files = ":empty",      # Added
    toolchain_config = ":x86_64_config",
)

# --- ARM64 Toolchain ---
cc_toolchain_config(
    name = "arm64_config",
    cpu = "arm64",
    gcc_path = "external/gcc_9_arm64/bin/aarch64-none-linux-gnu-gcc",
    ld_path = "external/gcc_9_arm64/bin/aarch64-none-linux-gnu-ld",
    ar_path = "external/gcc_9_arm64/bin/aarch64-none-linux-gnu-ar",
    cpp_path = "external/gcc_9_arm64/bin/aarch64-none-linux-gnu-cpp",
    # Point this to the root or the specific libc folder
    sysroot_path = "external/gcc_9_arm64",
)

cc_toolchain(
    name = "cc_arm64",
    all_files = "@gcc_9_arm64//:all_files",
    compiler_files = "@gcc_9_arm64//:all_files", # Must include the bin folder
    linker_files = "@gcc_9_arm64//:all_files",   # Must include the bin folder
    dwp_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":arm64_config",
)

# Toolchain registrations
toolchain(
    name = "gcc_x86_64_toolchain",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    toolchain = ":cc_x86_64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "gcc_arm64_toolchain",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    toolchain = ":cc_arm64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)


platform(
    name = "x86_64_platform",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "arm64_platform",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)
