cc_toolchain(
    name = "cc_x86_64_on_linux_aarch64",
    all_files      = ":llvm_linux_aarch64_with_x86_64_sysroot_files",
    ar_files       = ":llvm_linux_aarch64_with_x86_64_sysroot_files",
    compiler_files = ":llvm_linux_aarch64_with_x86_64_sysroot_files",
    linker_files   = ":llvm_linux_aarch64_with_x86_64_sysroot_files",
    dwp_files      = ":empty",
    objcopy_files  = ":empty",
    strip_files    = ":empty",
    toolchain_config = ":x86_64_on_linux_aarch64_config",
)

toolchain(
    name = "clang_x86_64_on_linux_aarch64_toolchain",
    exec_compatible_with   = ["@platforms//os:linux", "@platforms//cpu:aarch64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    toolchain = ":cc_x86_64_on_linux_aarch64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
