    all_files      = ":llvm_linux_aarch64_with_x86_64_sysroot_files",
    ar_files       = ":llvm_linux_aarch64_with_x86_64_sysroot_files",
    compiler_files = ":llvm_linux_aarch64_with_x86_64_sysroot_files",
    linker_files   = ":llvm_linux_aarch64_with_x86_64_sysroot_files",
    dwp_files      = ":empty",
    objcopy_files  = ":empty",
    strip_files    = ":empty",
    toolchain_config = ":x86_64_on_linux_aarch64_config",
