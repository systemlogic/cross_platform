load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load(":cc_toolchain_config.bzl", "cc_toolchain_config")
load(":linux_llvm_toolchain_config.bzl", "cc_linux_llvm_toolchain_config")
load(":macos_toolchain_config.bzl", "cc_macos_toolchain_config")
load("@macos_sdk//:sdk_path.bzl", "MACOS_SDK_PATH")
load("//proto:proto_toolchain.bzl", "proto_toolchain")

package(default_visibility = ["//visibility:public"])

# Mandatory empty filegroup for unused toolchain attributes
filegroup(name = "empty")

# =============================================================================
# Linux Toolchains — GCC cross-compilers downloaded from Bootlin / ARM
#
# exec: Linux x86_64
#   gcc_x86_64_toolchain  →  target: Linux x86_64  (Bootlin native x86_64 GCC)
#   gcc_arm64_toolchain   →  target: Linux arm64   (ARM cross-compiler)
#
# exec: Linux aarch64
#   gcc_arm64_native_toolchain        →  target: Linux arm64  (LLVM aarch64 + Bootlin aarch64 sysroot)
#   clang_x86_64_on_linux_aarch64_toolchain →  target: Linux x86_64  (LLVM aarch64 + Bootlin x86_64 sysroot)
# =============================================================================

# --- exec: Linux x86_64 / target: Linux x86_64 ---
cc_toolchain_config(
    name = "x86_64_config",
    cpu = "x86_64",
    gcc_path = "external/+toolchain_ext+gcc_9_x86_64/bin/x86_64-buildroot-linux-gnu-gcc",
    ld_path  = "external/+toolchain_ext+gcc_9_x86_64/bin/x86_64-buildroot-linux-gnu-ld",
    ar_path  = "external/+toolchain_ext+gcc_9_x86_64/bin/x86_64-buildroot-linux-gnu-ar",
    cpp_path = "external/+toolchain_ext+gcc_9_x86_64/bin/x86_64-buildroot-linux-gnu-cpp",
    sysroot_path = "external/+toolchain_ext+gcc_9_x86_64",
)

cc_toolchain(
    name = "cc_x86_64",
    all_files = "@gcc_9_x86_64//:all_files",
    ar_files = "@gcc_9_x86_64//:all_files",
    compiler_files = "@gcc_9_x86_64//:all_files",
    dwp_files = ":empty",
    linker_files = "@gcc_9_x86_64//:all_files",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":x86_64_config",
)

toolchain(
    name = "gcc_x86_64_toolchain",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    toolchain = ":cc_x86_64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# --- exec: Linux x86_64 / target: Linux arm64 (ARM cross-compiler) ---
cc_toolchain_config(
    name = "arm64_config",
    cpu = "arm64",
    gcc_path = "external/+toolchain_ext+gcc_9_arm64/bin/aarch64-none-linux-gnu-gcc",
    ld_path  = "external/+toolchain_ext+gcc_9_arm64/bin/aarch64-none-linux-gnu-ld",
    ar_path  = "external/+toolchain_ext+gcc_9_arm64/bin/aarch64-none-linux-gnu-ar",
    cpp_path = "external/+toolchain_ext+gcc_9_arm64/bin/aarch64-none-linux-gnu-cpp",
    sysroot_path = "external/+toolchain_ext+gcc_9_arm64",
)

cc_toolchain(
    name = "cc_arm64",
    all_files = "@gcc_9_arm64//:all_files",
    ar_files = "@gcc_9_arm64//:all_files",
    compiler_files = "@gcc_9_arm64//:all_files",
    linker_files = "@gcc_9_arm64//:all_files",
    dwp_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":arm64_config",
)

toolchain(
    name = "gcc_arm64_toolchain",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    toolchain = ":cc_arm64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# --- exec: Linux aarch64 / target: Linux arm64 (LLVM aarch64 + Bootlin aarch64 sysroot) ---
# Bootlin's aarch64--glibc tarball contains x86_64-hosted binaries (cross-compiler).
# Use aarch64-hosted LLVM instead for the compiler; keep the Bootlin sysroot for headers/libs.
filegroup(
    name = "llvm_linux_aarch64_with_aarch64_sysroot_files",
    srcs = [
        "@llvm_linux_aarch64//:all_files",
        "@gcc_aarch64_native//:all_files",
    ],
)

cc_linux_llvm_toolchain_config(
    name = "arm64_on_aarch64_config",
    cpu = "arm64",
    clang_path = "external/+toolchain_ext+llvm_linux_aarch64/bin/clang",
    ar_path    = "external/+toolchain_ext+llvm_linux_aarch64/bin/llvm-ar",
    ld_path    = "external/+toolchain_ext+llvm_linux_aarch64/bin/ld.lld",
    nm_path    = "external/+toolchain_ext+llvm_linux_aarch64/bin/llvm-nm",
    strip_path = "external/+toolchain_ext+llvm_linux_aarch64/bin/llvm-strip",
    target_triple     = "aarch64-buildroot-linux-gnu",
    sysroot_path      = "external/+toolchain_ext+gcc_aarch64_native/aarch64-buildroot-linux-gnu/sysroot",
    gcc_toolchain     = "external/+toolchain_ext+gcc_aarch64_native",
    clang_include_dir = "external/+toolchain_ext+llvm_linux_aarch64/lib/clang/18/include",
)

cc_toolchain(
    name = "cc_arm64_on_aarch64",
    all_files      = ":llvm_linux_aarch64_with_aarch64_sysroot_files",
    ar_files       = ":llvm_linux_aarch64_with_aarch64_sysroot_files",
    compiler_files = ":llvm_linux_aarch64_with_aarch64_sysroot_files",
    linker_files   = ":llvm_linux_aarch64_with_aarch64_sysroot_files",
    dwp_files      = ":empty",
    objcopy_files  = ":empty",
    strip_files    = ":empty",
    toolchain_config = ":arm64_on_aarch64_config",
)

toolchain(
    name = "gcc_arm64_native_toolchain",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:aarch64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    toolchain = ":cc_arm64_on_aarch64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# --- exec: Linux aarch64 / target: Linux x86_64 (LLVM aarch64 + Bootlin x86_64 sysroot) ---
filegroup(
    name = "llvm_linux_aarch64_with_x86_64_sysroot_files",
    srcs = [
        "@llvm_linux_aarch64//:all_files",
