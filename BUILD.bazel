    strip_path = "external/+toolchain_ext+llvm_linux_aarch64/bin/llvm-strip",
    target_triple     = "x86_64-buildroot-linux-gnu",
    sysroot_path      = "external/+toolchain_ext+gcc_9_x86_64/x86_64-buildroot-linux-gnu/sysroot",
    gcc_toolchain     = "external/+toolchain_ext+gcc_9_x86_64",
