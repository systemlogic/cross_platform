# Java Runtime Toolchains — Temurin JDK 21.0.11+10, one per exec platform
#
# Registered before rules_java's local_jdk so Bazel resolves to the downloaded
# JDK without requiring a host JVM installation.
# The runtime_toolchain_type is used both for running java_binary / java_test
# and for launching javabuilder (javac) via current_java_runtime.
# =============================================================================

toolchain(
    name = "jdk_macos_arm64_toolchain",
    exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:arm64"],
    target_compatible_with = [],
    toolchain = "@jdk_macos_arm64//:jdk",
    toolchain_type = "@bazel_tools//tools/jdk:runtime_toolchain_type",
)

toolchain(
    name = "jdk_macos_x86_64_toolchain",
    exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:x86_64"],
    target_compatible_with = [],
    toolchain = "@jdk_macos_x86_64//:jdk",
    toolchain_type = "@bazel_tools//tools/jdk:runtime_toolchain_type",
)

toolchain(
    name = "jdk_linux_x86_64_toolchain",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = [],
    toolchain = "@jdk_linux_x86_64//:jdk",
    toolchain_type = "@bazel_tools//tools/jdk:runtime_toolchain_type",
)

toolchain(
    name = "jdk_linux_aarch64_toolchain",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:aarch64"],
    target_compatible_with = [],
    toolchain = "@jdk_linux_aarch64//:jdk",
    toolchain_type = "@bazel_tools//tools/jdk:runtime_toolchain_type",
)

# macOS platform targets
platform(
    name = "macos_arm64_platform",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "macos_x86_64_platform",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

# =============================================================================
# Proto toolchains — protoc 29.3 + gRPC plugins, one per exec platform.
#
# exec_compatible_with: the machine where protoc runs (always the exec platform).
# No target_compatible_with: generated source files are language-level, not
# architecture-specific, so any target platform can use them.
# =============================================================================

proto_toolchain(
    name = "proto_toolchain_macos_arm64_impl",
    protoc = "@protoc_macos_arm64//:protoc",
    protoc_include_path = "external/+toolchain_ext+protoc_macos_arm64/include",
    protoc_includes = ["@protoc_macos_arm64//:well_known_protos"],
    grpc_go_plugin = "@protoc_gen_go_macos_arm64//:plugin",
    grpc_go_grpc_plugin = "@protoc_gen_go_grpc_macos_arm64//:plugin",
    grpc_java_plugin = "@protoc_gen_grpc_java_macos_arm64//:plugin",
)

toolchain(
    name = "proto_toolchain_macos_arm64",
    exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:arm64"],
    toolchain = ":proto_toolchain_macos_arm64_impl",
    toolchain_type = "//proto:toolchain_type",
)

proto_toolchain(
    name = "proto_toolchain_macos_x86_64_impl",
    protoc = "@protoc_macos_x86_64//:protoc",
    protoc_include_path = "external/+toolchain_ext+protoc_macos_x86_64/include",
