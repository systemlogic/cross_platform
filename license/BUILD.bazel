"""License declarations for all known external dependencies in this repo.

Usage from any BUILD file:

  load("//license:report.bzl", "license_report")

  license_report(
      name = "my_artifact_licenses",
      target = "//path/to:target",
      artifact_name = "My Artifact",
      deps_licenses = [
          "//license:java_grpc_deps",   # if your artifact uses Java gRPC
          "//license:go_grpc_deps",     # if your artifact uses Go gRPC
          "//license:python_requests",  # if your artifact uses requests
          # …pick the relevant sets below
      ],
  )

  # Build:  bazel build //path/to:my_artifact_licenses
  # Read:   cat bazel-bin/path/to/my_artifact_licenses_license_report.txt
"""

load("//license:defs.bzl", "license_declaration")
load("//license:report.bzl", "license_set")

package(default_visibility = ["//visibility:public"])

